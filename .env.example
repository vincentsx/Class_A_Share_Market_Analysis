# 默认免费沪深A股行情；demo 合成示例和 tushare 数据分别隔离。
DATA_SOURCE=baostock
DATABASE_URL=sqlite:///./data/stock_daily.db
FREE_REQUEST_INTERVAL=0.3
FREE_REQUEST_TIMEOUT=90
TUSHARE_TOKEN=
TUSHARE_URL=https://api.tushare.pro
TUSHARE_REQUEST_INTERVAL=0.7
# baostock 模式通过 AKShare 补查公告，无需 Tushare Token。
ENABLE_ANNOUNCEMENTS=true
# 免费滚动快讯：东方财富与财联社；worker北京时间08:00～21:00定期留存。
ENABLE_NEWS=true
NEWS_INTERVAL_MINUTES=10
NEWS_TIMEOUT=8
# GitHub Pages：先按README完成首次部署，再启用worker自动发布（运行账号须已登录gh）。
PAGES_ENABLED=false
PAGES_REPOSITORY=vincentsx/Class_A_Share_Market_Analysis
PAGES_RETAIN_DAYS=5
# 写入自选股 API 所需密钥。CLI 管理自选股无需此密钥。
APP_API_KEY=
# 北京时间：午间实时快照、收盘实时快照、晚间完整日线分析及公告。
MIDDAY_TIME=11:35
SCHEDULE_TIME=15:05
ANNOUNCEMENT_TIME=18:30
PORTFOLIO_INTERVAL_MINUTES=10
# 独立盘中分析：交易时段每10分钟采集缓存沪深A股、新闻舆情并调用已配置AI；不自动改交易规则。
REALTIME_ENABLED=true
REALTIME_INTERVAL_MINUTES=10
REALTIME_AI_ENABLED=true
HISTORY_SESSIONS=100
MIN_AMOUNT_YUAN=50000000
MIN_COVERAGE=0.98
MAX_CANDIDATES=20
# 数量上限只控制页面优先展示；规则命中完整存档。
BACKUP_ENABLED=true
BACKUP_DIR=./data/backups
BACKUP_RETAIN_DAYS=7
# AI配置：盘中分析在每次采集后自动调用；另可手动生成证据摘要。
# responses使用官方Responses结构化输出；兼容服务可选chat_completions（JSON输出并本地校验）。
AI_API_KEY=
AI_API_BASE_URL=https://api.openai.com/v1
AI_API_STYLE=responses
AI_MODEL=
# 兼容旧配置；AI_API_KEY非空时优先使用AI_API_KEY。
OPENAI_API_KEY=
# 可选：任务失败后向你配置的 webhook POST JSON，默认关闭。
ALERT_WEBHOOK=
EXPORT_HTML=true
EXPORT_PNG=true
HTML_REPORT_DIR=./data/html

# Gmail报告邮件：两步验证后的应用专用密码，填入本地.env，配置完成后再启用。
EMAIL_ENABLED=false
# 每笔新确认的模拟买入/卖出分别发送提醒，复用下方邮箱；无需HTML/PNG附件。
TRADE_EMAIL_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_TO=
SMTP_TIMEOUT=20
# 编码后整封邮件的大小上限（MiB）。
MAIL_MAX_MB=20


# 企业微信智能机器人长连接：缺少Bot ID或Secret时跳过企业微信通知，邮件独立工作。
WECOM_BOT_ID=
WECOM_BOT_SECRET=
WECOM_WS_URL=wss://openws.work.weixin.qq.com
# 可直接指定单聊userid或群chatid；留空时用一次性口令绑定。
WECOM_CHAT_ID=
WECOM_CHAT_TYPE=single
# 本机生成的一次性绑定口令；通过机器人单聊发送“订阅交易提醒 口令”，30分钟有效。
WECOM_PAIR_CODE=
