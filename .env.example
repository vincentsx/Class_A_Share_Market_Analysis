# 默认免费沪深A股行情；demo 合成示例和 tushare 数据分别隔离。
DATA_SOURCE=baostock
DATABASE_URL=sqlite:///./data/stock_daily.db
FREE_REQUEST_INTERVAL=0.3
FREE_REQUEST_TIMEOUT=90
TUSHARE_TOKEN=
TUSHARE_URL=https://api.tushare.pro
TUSHARE_REQUEST_INTERVAL=0.7
# baostock 模式通过 AKShare 补查公告，无需 Tushare Token。
ENABLE_ANNOUNCEMENTS=true
# 写入自选股 API 所需密钥。CLI 管理自选股无需此密钥。
APP_API_KEY=
# 北京时间：午间实时快照、收盘实时快照、晚间完整日线分析及公告。
MIDDAY_TIME=11:35
SCHEDULE_TIME=15:05
ANNOUNCEMENT_TIME=20:30
HISTORY_SESSIONS=100
MIN_AMOUNT_YUAN=50000000
MIN_COVERAGE=0.98
MAX_CANDIDATES=20
# 可选：任务失败后向你配置的 webhook POST JSON，默认关闭。
ALERT_WEBHOOK=
EXPORT_HTML=true
EXPORT_PNG=true
HTML_REPORT_DIR=./data/html

# Gmail报告邮件：两步验证后的应用专用密码，填入本地.env，配置完成后再启用。
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_TO=
SMTP_TIMEOUT=20
# 编码后整封邮件的大小上限（MiB）。
MAIL_MAX_MB=20

