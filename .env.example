# demo 使用合成数据；切换 tushare 后使用真实接口，两者的数据完全隔离。
DATA_SOURCE=demo
DATABASE_URL=sqlite:///./data/stock_daily.db
TUSHARE_TOKEN=
TUSHARE_URL=https://api.tushare.pro
TUSHARE_REQUEST_INTERVAL=0.7
ENABLE_ANNOUNCEMENTS=false
# 写入自选股 API 所需密钥。CLI 管理自选股无需此密钥。
APP_API_KEY=
SCHEDULE_TIME=17:30
ANNOUNCEMENT_TIME=21:30
HISTORY_SESSIONS=100
MIN_AMOUNT_YUAN=50000000
MIN_COVERAGE=0.98
MAX_CANDIDATES=20
# 可选：任务失败后向你配置的 webhook POST JSON，默认关闭。
ALERT_WEBHOOK=

